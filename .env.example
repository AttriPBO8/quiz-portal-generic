# Copy to .env (or run `npm run setup`, which fills in random values for you).
# On AWS these are set under Amplify > Hosting > Environment variables.

# PostgreSQL connection string.
DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/quizportal"

# Signs login sessions. At least 32 random characters. Changing it signs everyone out.
SESSION_SECRET=""

# Starting password for quiz-takers added without one. Letters and numbers.
DEFAULT_USER_PASSWORD=""

# Password given to the sample admin accounts by `npm run db:seed`.
SEED_ADMIN_PASSWORD=""

# ---- Per-customer settings (see docs/SAAS.md). NEXT_PUBLIC_ ones need a rebuild to change. ----

# Name shown in the header and browser tab.
# NEXT_PUBLIC_PORTAL_NAME="Quiz Portal"
# Time zone for every date shown or entered (IANA name). Default America/Toronto.
# NEXT_PUBLIC_TIME_ZONE="America/Toronto"
# What this customer calls a user's group: Team, Department, Location, Class… Default Group.
# NEXT_PUBLIC_GROUP_LABEL="Group"
# Country code that users may leave off their phone number at sign-in, e.g. 1 (Canada/US) or 91 (India).
# DEFAULT_COUNTRY_CODE="1"
# Printed on certificates.
# CERTIFICATE_ORGANIZATION="Sample Training Institute"
# CERTIFICATE_PLACE="Toronto, Canada"

# ---- "Continue with Google / Facebook" (optional; see docs/SOCIAL-LOGIN.md) ----
# The app's public address, used to build the return address registered with Google and Facebook.
# APP_URL="https://quiz.example.com"
# Each provider is shown only when both of its values are set.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# FACEBOOK_CLIENT_ID=""
# FACEBOOK_CLIENT_SECRET=""

# ---- Question media ----
# On AWS: the private S3 bucket for pictures, sound and video, and its region.
# MEDIA_BUCKET=""
# MEDIA_BUCKET_REGION="ap-south-1"
# On a laptop (no MEDIA_BUCKET): the folder media is saved in. Default media-files.
# MEDIA_DIR="media-files"

# Optional. Folder for the log files (one file per log type per day). Defaults to "logs" on a
# laptop; leave unset on AWS, where logs go to CloudWatch.
# LOG_DIR="logs"

# Optional. Most requests one internet address may make per minute (default 1200).
# RATE_LIMIT_PER_MINUTE=1200
